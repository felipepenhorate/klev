{
  "name": "decision_record",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "state": {
        "type": "string",
        "description": "The document, ticket, case or passage the questions are about."
      },
      "questions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "properties": {
            "type": { "enum": ["noul", "choice", "score"] },
            "instructions": { "type": "string" },
            "criteria": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "properties": {
                  "key": { "type": "string" },
                  "description": { "type": "string" }
                },
                "required": ["key", "description"],
                "additionalProperties": false
              }
            },
            "label": {
              "type": "string",
              "description": "noul: true/false; choice: one criteria key; score: the 0-based level index as a string."
            },
            "garbage": {
              "type": "boolean",
              "description": "true only when the state does not support any option (the answer is none of them)."
            },
            "target": {
              "type": "array",
              "description": "optional soft label for genuinely ambiguous questions: probabilities over keys summing to 1.",
              "items": {
                "type": "object",
                "properties": {
                  "key": { "type": "string" },
                  "p": { "type": "number" }
                },
                "required": ["key", "p"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type", "instructions", "criteria", "label"],
          "additionalProperties": false
        }
      }
    },
    "required": ["state", "questions"],
    "additionalProperties": false
  }
}
